{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Functor",
  "version": "0.1.1",
  "identifier": "app.functor.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev -- --strictPort", "cwd": "../web" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../web" }
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Functor", "width": 1400, "height": 900, "minWidth": 720, "minHeight": 480 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Typesetting language for mathematics",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["fn"], "name": "Functor document", "mimeType": "text/x-functor", "role": "Editor" }
    ],
    "macOS": { "signingIdentity": "-" }
  }
}
