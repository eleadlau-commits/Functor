{
  "name": "functor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "cargo build --release -p functor-wasm --target wasm32-unknown-unknown && node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('../target/wasm32-unknown-unknown/release/functor_wasm.wasm','public/functor.wasm')\"",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "glyphs": "node ../scripts/extract-glyphs.mjs",
    "smoke": "node ../scripts/smoke.mjs",
    "smoke:desktop": "node ../scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.5",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "vite": "^5.4.21"
  }
}
